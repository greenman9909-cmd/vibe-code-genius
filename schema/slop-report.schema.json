{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/slop-report.schema.json",
  "title": "slop-report",
  "type": "object",
  "required": [
    "status",
    "version",
    "score",
    "audits",
    "eliminated_phrases",
    "evidence"
  ],
  "minProperties": 6,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0
    },
    "audits": {
      "type": "array",
      "minItems": 2
    },
    "eliminated_phrases": {
      "type": "array",
      "minItems": 2
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  }
}
