{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/slop-report.schema.json",
  "title": "slop-report",
  "type": "object",
  "required": [
    "status",
    "version",
    "score",
    "audits",
    "eliminated_phrases",
    "findings",
    "evidence"
  ],
  "minProperties": 6,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "eliminated_phrases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "keep",
              "rewrite",
              "remove"
            ]
          }
        },
        "required": [
          "kind",
          "text",
          "reason",
          "action"
        ]
      }
    }
  },
  "additionalProperties": false
}
