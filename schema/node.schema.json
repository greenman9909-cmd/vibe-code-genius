{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/node.schema.json",
  "title": "God Tree node",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}[a-z]?$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "prereqs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "parallel_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "activates_when": {
      "type": "string",
      "minLength": 1
    },
    "skill_file": {
      "type": "string",
      "pattern": "^nodes/.+\\.md$"
    },
    "artifact_schema": {
      "type": "string",
      "pattern": "^schema/.+\\.schema\\.json$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "max_response_tokens": {
      "type": "integer",
      "minimum": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "optional": {
      "type": "boolean"
    },
    "activation_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "tier",
    "prereqs",
    "parallel_with",
    "input",
    "output",
    "activates_when",
    "skill_file",
    "artifact_schema",
    "model",
    "max_response_tokens",
    "version",
    "consumers",
    "expected_artifact_path"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "optional": {
            "const": true
          }
        },
        "required": [
          "optional"
        ]
      },
      "then": {
        "required": [
          "activation_key"
        ]
      }
    }
  ]
}
