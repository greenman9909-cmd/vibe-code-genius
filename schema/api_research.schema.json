{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/api_research.schema.json",
  "title": "api_research",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "base_url": {
      "type": "string"
    },
    "auth": {
      "type": "object"
    },
    "versioning": {
      "type": "object"
    },
    "pagination": {
      "type": "object"
    },
    "rate_limit": {
      "type": "object"
    },
    "error_format": {
      "type": "object"
    },
    "endpoints": {
      "type": "array"
    },
    "graphql_schema": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "generated_at",
    "base_url",
    "auth",
    "versioning",
    "pagination",
    "rate_limit",
    "error_format",
    "endpoints"
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
