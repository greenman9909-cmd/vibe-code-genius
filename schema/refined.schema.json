{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/refined.schema.json",
  "title": "refined",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "pass": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "problem": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "problem",
          "change",
          "verification"
        ]
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "generated_at",
    "pass",
    "changes",
    "regressions",
    "remaining",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pass": {
            "const": true
          }
        },
        "required": [
          "pass"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "regressions": {
            "maxItems": 0
          },
          "remaining": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
