{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/prompt.schema.json",
  "title": "prompt",
  "type": "object",
  "required": [
    "required_headings"
  ],
  "properties": {
    "required_headings": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string"
      }
    }
  },
  "required_headings": [
    "REFERENCE STACK",
    "ROUTE MAP",
    "HOMEPAGE SECTIONS",
    "KEY COMPONENTS",
    "DESIGN TOKENS",
    "API SURFACE",
    "MY PRODUCT",
    "BUILD INSTRUCTIONS",
    "OUTPUT FORMAT"
  ]
}
