{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/session.schema.json",
  "title": "session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "reference_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "tier_stop": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "active_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "complete",
              "blocked",
              "failed",
              "skipped"
            ]
          },
          "artifact": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "artifact",
          "errors"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoints": {
      "type": "array"
    },
    "budget": {
      "type": "object"
    },
    "why_log": {
      "type": "array"
    },
    "active_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "status",
    "session_id",
    "started_at",
    "updated_at",
    "intent",
    "reference_url",
    "tier_stop",
    "features",
    "active_features",
    "active_skills",
    "nodes",
    "artifacts",
    "checkpoints",
    "budget",
    "why_log"
  ]
}
