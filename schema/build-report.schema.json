{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/build-report.schema.json",
  "title": "build-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "pass": {
      "type": "boolean"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "install",
              "lint",
              "typecheck",
              "test",
              "build",
              "other"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "kind",
          "command",
          "exit_code",
          "evidence"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "generated_at",
    "pass",
    "commands",
    "artifacts",
    "warnings",
    "failures",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pass": {
            "const": true
          }
        },
        "required": [
          "pass"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "failures": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
