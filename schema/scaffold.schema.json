{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/scaffold.schema.json",
  "title": "scaffold",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "private": {
      "type": "boolean"
    },
    "scripts": {
      "type": "object",
      "minProperties": 1
    },
    "dependencies": {
      "type": "object"
    },
    "devDependencies": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "version",
    "scripts"
  ]
}
