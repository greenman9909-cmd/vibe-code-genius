{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/estimate.schema.json",
  "title": "estimate",
  "type": "object",
  "required": [
    "status",
    "version",
    "tier_stop",
    "total_nodes",
    "tokens_estimated",
    "evidence"
  ],
  "minProperties": 6,
  "properties": {
    "status": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tier_stop": {
      "type": "integer"
    },
    "total_nodes": {
      "type": "integer",
      "minimum": 1
    },
    "tokens_estimated": {
      "type": "integer",
      "minimum": 1000
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  }
}
