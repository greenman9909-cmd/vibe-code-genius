{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/tokens.schema.json",
  "title": "tokens",
  "type": "object",
  "required": [
    "version",
    "status",
    "colors",
    "typography",
    "spacing",
    "radii",
    "shadows",
    "evidence"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "colors": {
      "type": "object"
    },
    "typography": {
      "type": "object",
      "minProperties": 2
    },
    "spacing": {
      "type": "object",
      "minProperties": 2
    },
    "radii": {
      "type": "object",
      "minProperties": 2
    },
    "shadows": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  }
}
