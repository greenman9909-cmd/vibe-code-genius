{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/tokens.schema.json",
  "title": "Design Tokens Schema",
  "type": "object",
  "required": ["colors", "typography", "spacing", "radii"],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string" },
    "colors": { "type": "object" },
    "typography": { "type": "object" },
    "spacing": { "type": "object" },
    "radii": { "type": "object" },
    "shadows": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
