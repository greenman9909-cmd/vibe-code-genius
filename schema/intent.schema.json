{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/intent.schema.json",
  "title": "intent",
  "type": "object",
  "required": [
    "status",
    "version",
    "product_name",
    "product_type",
    "target_user",
    "key_flows"
  ],
  "minProperties": 6,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_type": {
      "type": "string"
    },
    "target_user": {
      "type": "string"
    },
    "key_flows": {
      "type": "array",
      "minItems": 2
    },
    "reference_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "vibe": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
