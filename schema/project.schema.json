{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://godtree.local/schema/project.schema.json",
  "title":"GodTree Project",
  "type":"object",
  "required":["version","id","name","workspace","git","policy"],
  "properties":{
    "version":{"const":"1.0.0"},
    "id":{"type":"string","minLength":1},
    "name":{"type":"string","minLength":1},
    "workspace":{"type":"string","minLength":1},
    "git":{
      "type":"object",
      "required":["enabled"],
      "properties":{
        "enabled":{"type":"boolean"},
        "remote":{"type":["string","null"]},
        "default_branch":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "policy":{
      "type":"object",
      "required":["zero_cost_first","require_confirmation_for_push","require_confirmation_for_deploy"],
      "properties":{
        "zero_cost_first":{"const":true},
        "require_confirmation_for_push":{"type":"boolean"},
        "require_confirmation_for_deploy":{"type":"boolean"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
