{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/static-report.schema.json",
  "title": "static-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "pass": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "status",
          "evidence"
        ]
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "generated_at",
    "pass",
    "checks",
    "failures",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pass": {
            "const": true
          }
        },
        "required": [
          "pass"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "failures": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
