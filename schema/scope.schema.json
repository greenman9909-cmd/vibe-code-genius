{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/scope.schema.json",
  "title": "scope",
  "type": "object",
  "required": [
    "status",
    "version",
    "deliverable",
    "tier_stop",
    "routes_include",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "deliverable": {
      "type": "string"
    },
    "tier_stop": {
      "type": "integer"
    },
    "routes_include": {
      "type": "array",
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  }
}
