{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/scope.schema.json",
  "title": "scope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "deliverable": {
      "type": "string",
      "minLength": 1
    },
    "tier_stop": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "routes_include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "routes_exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "api",
          "backend",
          "database",
          "auth",
          "forms",
          "integrations",
          "deployment",
          "motion",
          "multi_agent",
          "reference_comparison",
          "deep_reference",
          "clone_extract"
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "deliverable",
    "tier_stop",
    "routes_include",
    "routes_exclude",
    "capabilities",
    "acceptance_criteria",
    "out_of_scope",
    "evidence"
  ]
}
