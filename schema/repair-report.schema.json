{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/repair-report.schema.json",
  "title": "repair-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "tools_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixes_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "problem": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "problem",
          "change",
          "evidence"
        ]
      }
    },
    "regressions_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unfixed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "generated_at",
    "trigger",
    "tools_touched",
    "fixes_applied",
    "regressions_added",
    "unfixed",
    "skipped",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "unfixed": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
