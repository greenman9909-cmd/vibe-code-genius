{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/suitability.schema.json",
  "title": "suitability",
  "type": "object",
  "required": [
    "status",
    "version",
    "suitability_score",
    "product_category",
    "evidence"
  ],
  "minProperties": 5,
  "properties": {
    "status": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "suitability_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "product_category": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  }
}
