{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/manifest.schema.json",
  "title": "manifest",
  "type": "object",
  "required": [
    "status",
    "version",
    "routes",
    "components",
    "artifacts",
    "gates",
    "evidence"
  ],
  "minProperties": 7,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "minItems": 5
    },
    "components": {
      "type": "array",
      "minItems": 4
    },
    "artifacts": {
      "type": "array",
      "minItems": 5
    },
    "gates": {
      "type": "object",
      "minProperties": 2
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  }
}
