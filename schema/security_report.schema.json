{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/security_report.schema.json",
  "title": "security-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "review",
        "hardening",
        "verification"
      ]
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "category",
          "status",
          "evidence"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "fixed",
              "accepted",
              "not-applicable"
            ]
          },
          "description": {
            "type": "string"
          },
          "proof": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "status",
          "description",
          "proof",
          "fix"
        ]
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pass": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "generated_at",
    "stage",
    "baseline",
    "checks",
    "findings",
    "blocking_findings",
    "patches",
    "pass",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pass": {
            "const": true
          }
        },
        "required": [
          "pass"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "blocking_findings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
