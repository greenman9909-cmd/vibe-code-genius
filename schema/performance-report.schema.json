{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-code-genius.dev/schema/performance-report.schema.json",
  "title": "performance-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "boolean"
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "budget": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "observed",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "metric",
          "value",
          "unit",
          "budget",
          "status",
          "evidence"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "status",
    "version",
    "generated_at",
    "target",
    "pass",
    "measurements",
    "findings",
    "blocking_regressions",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pass": {
            "const": true
          }
        },
        "required": [
          "pass"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          },
          "blocking_regressions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
